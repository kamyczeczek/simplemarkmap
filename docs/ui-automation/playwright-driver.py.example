"""Minimalny przykład drivera; kod produkcyjny wymaga osobnej weryfikacji bezpieczeństwa."""
from playwright.sync_api import sync_playwright


class AccessibilityDriver:
    def __init__(self, url: str, headless: bool = True):
        self._pw = sync_playwright().start()
        self._browser = self._pw.chromium.launch(headless=headless)
        self.page = self._browser.new_page()
        self.page.goto(url)

    def _locator(self, selector: dict):
        allowed = {"role", "name", "label", "testId"}
        if not isinstance(selector, dict) or not set(selector) <= allowed:
            raise ValueError("Nieprawidłowy selektor accessibility")
        if selector.get("testId"):
            return self.page.get_by_test_id(selector["testId"])
        if selector.get("label"):
            return self.page.get_by_label(selector["label"])
        if selector.get("role"):
            return self.page.get_by_role(selector["role"], name=selector.get("name"))
        raise ValueError("Selektor wymaga role, label lub testId")

    def click_element(self, selector: dict):
        self._locator(selector).click()
        return {"status": "clicked", "action": "click", "selector": selector}

    def type_text(self, selector: dict, text: str):
        self._locator(selector).fill(text)
        return {"status": "typed", "action": "type", "selector": selector}

    def get_text(self, selector: dict):
        return {"status": "ok", "action": "get_text", "text": self._locator(selector).inner_text()}

    def close(self):
        self._browser.close()
        self._pw.stop()
